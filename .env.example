# Скопируй в .env.local для локального запуска; на Vercel — в Settings → Environment Variables.
# Supabase → Connect → Framework → Next.js: строки из вкладки .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Почта игрока: войти и писать события может только она.
ALLOWED_EMAIL=
