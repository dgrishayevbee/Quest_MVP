# Скопируй в .env.local для локального запуска; на Vercel — в Settings → Environment Variables.
# Supabase → Connect (или Project Settings → API): Project URL и anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Почта игрока: войти и писать события может только она.
ALLOWED_EMAIL=
