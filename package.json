{
  "name": "put-provodnika",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build",
    "start": "next start",
    "verify": "npm test && npm run check",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types --no-warnings engine/cli/check.ts",
    "test": "node --experimental-strip-types --no-warnings --test engine/test/*.test.ts lib/server/*.test.ts",
    "build:proto": "node --experimental-strip-types --no-warnings engine/cli/build-proto.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
